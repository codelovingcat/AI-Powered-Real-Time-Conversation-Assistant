{
  "expo": {
    "name": "Conversa",
    "slug": "conversa-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "conversa",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.conversa.mobile",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "Conversa uses your microphone only when you explicitly start a live conversation.",
          "androidPermissions": [
            "android.permission.RECORD_AUDIO"
          ]
        }
      ]
    ]
  }
}
