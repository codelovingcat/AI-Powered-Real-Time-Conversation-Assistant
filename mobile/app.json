{
  "expo": {
    "name": "Conversa",
    "slug": "conversa-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "conversa",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.conversa.mobile",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Conversa uses your microphone only when you explicitly start capture.",
          "recordAudioAndroid": true
        }
      ]
    ]
  }
}
