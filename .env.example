# Copy to .env or export these variables. Never commit the populated file.
# ASP.NET Core maps double underscores to configuration sections.

ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=conversa;Username=conversa;Password=<local-dev-password>

# Required only when calling the assistant endpoint. Never commit this value.
Gemini__ApiKey=

# Required to enable the Deepgram speech-to-text provider. Never commit this value.
Deepgram__ApiKey=
Deepgram__Model=nova-3
Deepgram__BaseUrl=https://api.deepgram.com
Deepgram__EndpointingMilliseconds=300

# Authentication signing configuration. Keep the signing key in user-secrets or a secret manager.
Authentication__Issuer=conversa-local
Authentication__Audience=conversa-api
Authentication__SigningKey=

# Optional overrides.
Gemini__Model=gemini-3.8-flash
Gemini__BaseUrl=https://generativelanguage.googleapis.com/

# Docker Compose PostgreSQL settings.
POSTGRES_USER=conversa
POSTGRES_PASSWORD=<local-dev-password>
POSTGRES_DB=conversa
