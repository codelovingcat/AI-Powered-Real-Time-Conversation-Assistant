# Copy to .env or export these variables. Do not commit real secrets.
# ASP.NET Core maps double underscores to configuration sections.

ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=conversa;Username=conversa;Password=conversa

# Required only when calling the assistant endpoint. Never commit this value.
Gemini__ApiKey=

# Authentication signing configuration. Keep the signing key in user-secrets or a secret manager.
Authentication__Issuer=conversa-local
Authentication__Audience=conversa-api
Authentication__SigningKey=

# Optional overrides.
Gemini__Model=gemini-2.5-flash
Gemini__BaseUrl=https://generativelanguage.googleapis.com/
